# ----------------------------------------------------------------              
# CONFIGURACIÓN DEL BACKEND (FastAPI)
# ----------------------------------------------------------------              

# Clave de API de OpenAI para el procesamiento de lenguaje natural
# Consíguela en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_clave_aqui_sin_comillas

# Configuración del servidor (Opcional)
HOST=0.0.0.0
PORT=8000
DEBUG=True
BACKEND_URL=http://localhost:8000

# ----------------------------------------------------------------              
# CONFIGURACIÓN DE VISIÓN (YOLO / OpenCV)
# ----------------------------------------------------------------              

# Ruta al modelo de YOLO (ej: yolov8n.pt para la versión nano)
YOLO_MODEL_PATH=models/yolov8n.pt

# Índice de la cámara (0 suele ser la webcam integrada)
CAMERA_INDEX=0

# Umbral de confianza para la detección de objetos (0.0 a 1.0)
DETECTION_THRESHOLD=0.5

# ----------------------------------------------------------------              
# CONFIGURACIÓN DEL FRONTEND (React)
# ----------------------------------------------------------------              

# URL del backend para que el frontend sepa a dónde conectar
VITE_API_URL=http://localhost:8000
VITE_AGENT_URL=http://localhost:8002